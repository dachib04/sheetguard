{
  "$defs": {
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "title": "Address",
          "type": "string"
        },
        "formula": {
          "anyOf": [
            {
              "$ref": "#/$defs/UntrustedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/UntrustedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "address"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "affected_count": {
          "default": 1,
          "title": "Affected Count",
          "type": "integer"
        },
        "cell": {
          "title": "Cell",
          "type": "string"
        },
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "high"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "sheet": {
          "title": "Sheet",
          "type": "string"
        },
        "suggested_fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/UntrustedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "check_id",
        "severity",
        "sheet",
        "cell",
        "description"
      ],
      "title": "Issue",
      "type": "object"
    },
    "OutputCandidate": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "title": "Address",
          "type": "string"
        },
        "upstream_cells": {
          "title": "Upstream Cells",
          "type": "integer"
        }
      },
      "required": [
        "address",
        "upstream_cells"
      ],
      "title": "OutputCandidate",
      "type": "object"
    },
    "ReportOptions": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "min_severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "checks",
        "min_severity"
      ],
      "title": "ReportOptions",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SheetSummary": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "title": "Cells",
          "type": "integer"
        },
        "formulas": {
          "title": "Formulas",
          "type": "integer"
        },
        "hidden_columns": {
          "title": "Hidden Columns",
          "type": "integer"
        },
        "hidden_rows": {
          "title": "Hidden Rows",
          "type": "integer"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "protected": {
          "title": "Protected",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "visible",
            "hidden",
            "veryHidden"
          ],
          "title": "State",
          "type": "string"
        },
        "tables": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tables",
          "type": "array"
        },
        "used_range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Used Range"
        }
      },
      "required": [
        "name",
        "index",
        "state",
        "used_range",
        "cells",
        "formulas",
        "hidden_rows",
        "hidden_columns",
        "protected"
      ],
      "title": "SheetSummary",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "by_check": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Check",
          "type": "object"
        },
        "by_severity": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Severity",
          "type": "object"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "by_severity",
        "by_check"
      ],
      "title": "Summary",
      "type": "object"
    },
    "UntrustedFinding": {
      "additionalProperties": false,
      "description": "One flagged text item (\u00a76 list_untrusted_content, \u00a77.2).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "integer"
        },
        "signals": {
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "text": {
          "$ref": "#/$defs/UntrustedText"
        },
        "vector": {
          "title": "Vector",
          "type": "string"
        }
      },
      "required": [
        "id",
        "vector",
        "location",
        "risk",
        "score",
        "signals",
        "reasons",
        "text"
      ],
      "title": "UntrustedFinding",
      "type": "object"
    },
    "UntrustedSummary": {
      "additionalProperties": false,
      "properties": {
        "by_risk": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Risk",
          "type": "object"
        },
        "by_vector": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Vector",
          "type": "object"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "by_risk",
        "by_vector"
      ],
      "title": "UntrustedSummary",
      "type": "object"
    },
    "UntrustedText": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "kind": {
          "const": "untrusted_text",
          "default": "untrusted_text",
          "title": "Kind",
          "type": "string"
        },
        "original_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Length"
        },
        "risk": {
          "default": "none",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "text"
      ],
      "title": "UntrustedText",
      "type": "object"
    },
    "WorkbookFlags": {
      "additionalProperties": false,
      "properties": {
        "activex": {
          "title": "Activex",
          "type": "boolean"
        },
        "cached_values": {
          "title": "Cached Values",
          "type": "boolean"
        },
        "calc_mode": {
          "title": "Calc Mode",
          "type": "string"
        },
        "data_connections": {
          "title": "Data Connections",
          "type": "boolean"
        },
        "date_1904": {
          "title": "Date 1904",
          "type": "boolean"
        },
        "dde": {
          "title": "Dde",
          "type": "boolean"
        },
        "external_links": {
          "title": "External Links",
          "type": "boolean"
        },
        "hidden_sheets": {
          "title": "Hidden Sheets",
          "type": "integer"
        },
        "iterative_calc": {
          "title": "Iterative Calc",
          "type": "boolean"
        },
        "macros_present": {
          "title": "Macros Present",
          "type": "boolean"
        },
        "ole_objects": {
          "title": "Ole Objects",
          "type": "boolean"
        },
        "untrusted_content_found": {
          "default": false,
          "title": "Untrusted Content Found",
          "type": "boolean"
        },
        "vba": {
          "title": "Vba",
          "type": "boolean"
        },
        "very_hidden_sheets": {
          "title": "Very Hidden Sheets",
          "type": "integer"
        },
        "workbook_protected": {
          "title": "Workbook Protected",
          "type": "boolean"
        },
        "xlm_macros": {
          "title": "Xlm Macros",
          "type": "boolean"
        }
      },
      "required": [
        "macros_present",
        "vba",
        "xlm_macros",
        "external_links",
        "dde",
        "ole_objects",
        "activex",
        "data_connections",
        "hidden_sheets",
        "very_hidden_sheets",
        "cached_values",
        "calc_mode",
        "iterative_calc",
        "date_1904",
        "workbook_protected"
      ],
      "title": "WorkbookFlags",
      "type": "object"
    },
    "WorkbookInfo": {
      "additionalProperties": false,
      "properties": {
        "cell_count": {
          "title": "Cell Count",
          "type": "integer"
        },
        "defined_names": {
          "title": "Defined Names",
          "type": "integer"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "flags": {
          "$ref": "#/$defs/WorkbookFlags"
        },
        "formula_count": {
          "title": "Formula Count",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "sheet_count": {
          "title": "Sheet Count",
          "type": "integer"
        },
        "sheets": {
          "items": {
            "$ref": "#/$defs/SheetSummary"
          },
          "title": "Sheets",
          "type": "array"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "tables": {
          "title": "Tables",
          "type": "integer"
        }
      },
      "required": [
        "file_name",
        "sha256",
        "size_bytes",
        "sheet_count",
        "cell_count",
        "formula_count",
        "defined_names",
        "tables",
        "flags",
        "sheets"
      ],
      "title": "WorkbookInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "likely_outputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OutputCandidate"
      },
      "title": "Likely Outputs",
      "type": "array"
    },
    "options": {
      "$ref": "#/$defs/ReportOptions"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "tool": {
      "default": "sheetguard",
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "untrusted_content": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UntrustedFinding"
      },
      "title": "Untrusted Content",
      "type": "array"
    },
    "untrusted_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/UntrustedSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workbook": {
      "$ref": "#/$defs/WorkbookInfo"
    }
  },
  "required": [
    "tool_version",
    "workbook",
    "options",
    "summary"
  ],
  "title": "Report",
  "type": "object"
}
